# Core
LOG_LEVEL=INFO
ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf
REVIEW_CONFIDENCE_THRESHOLD=0.5
STORE_REVIEW_SCORE_THRESHOLD=0.6
NORMALIZATION_RULES_PATH=config/normalization_rules.json

# Ingestion (Cloudflare R2)
INGESTION_BACKEND=r2
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_INBOX_PREFIX=inbox/
R2_ARCHIVE_PREFIX=archive/

# Native AWS S3 alternative (recommended for private alpha)
# INGESTION_BACKEND=s3
S3_BUCKET_NAME=
S3_REGION=ap-southeast-1
S3_INBOX_PREFIX=inbox/
S3_ARCHIVE_PREFIX=archive/

# Private-alpha limits
ALPHA_AUTH_ENABLED=false
ALPHA_MAX_USERS=10
ALPHA_DOCUMENT_LIMIT=20
ALPHA_GLOBAL_PAGE_LIMIT=1000
MAX_UPLOAD_BYTES=5242880
MAX_PDF_PAGES=5

# Ledger (PostgreSQL)
LEDGER_BACKEND=postgres
POSTGRES_DSN=postgresql://user:password@host:5432/dbname
POSTGRES_TABLE=ledger_records

# Extraction providers
EXTRACTION_PROVIDER=auto
EXTRACTION_PROVIDER_ORDER=mistral,openrouter,groq
MISTRAL_MODEL=mistral-small-latest
MISTRAL_API_KEY=

# Optional fallback keys
OPENROUTER_API_KEY=
GROQ_API_KEY=
